meta {
  name: Cliente inexistente (404)
  type: http
  seq: 2
}

post {
  url: {{pedidosUrl}}/api/pedidos
  body: none
  auth: none
}

params:query {
  clienteId: 99
  pedidoId: P-9999
}

script:post-response {
  test("responde 404", function() {
    expect(res.status).to.equal(404);
  });
  test("devuelve el mensaje de error", function() {
    expect(res.body).to.equal("Cliente no encontrado");
  });
}
